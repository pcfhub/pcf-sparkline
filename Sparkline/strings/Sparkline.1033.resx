<data name="Sparkline_Name" xml:space="preserve">
    <value>Sparkline</value>
  </data>
  <data name="Sparkline_Desc" xml:space="preserve">
    <value>A compact trend chart over any Dataverse view.</value>
  </data>

  <data name="Records_DataSet_Name" xml:space="preserve">
